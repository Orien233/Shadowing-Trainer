# Shadowing Trainer v0.4.1 runtime defaults
# Copy this file to backend/.env and edit only for your local deployment.
APP_NAME=Shadowing Trainer
APP_VERSION=0.4.1
DEBUG=true
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATA_DIR=./data

# Local Whisper is optional. Install requirements-local-whisper.txt only when
# local ASR is required. The model is loaded lazily; downloads can be disabled
# for offline deployments after placing the model in this cache directory.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_MODEL_DIR=./data/models/whisper
WHISPER_ALLOW_DOWNLOAD=true

# Provider credentials and provider defaults are managed in Settings and stored
# in the backend database. Current registered remote profiles are OpenAI Chat
# Completions, OpenAI Audio TTS, OpenAI Audio Transcription, MiMo TTS, and MiMo
# ASR. Do not put production credentials in a URL.
#
# Endpoint conventions in Settings:
# - OpenAI Chat and OpenAI ASR take a base URL; the app appends their documented
#   /chat/completions or /audio/transcriptions path.
# - OpenAI TTS and MiMo TTS/ASR require the complete endpoint. The app never
#   appends a path to a full endpoint.
# - OpenAI TTS does not send a language instruction by default. Enable the
#   explicit provider compatibility field send_language_instruction only when
#   the selected endpoint supports the optional OpenAI instructions field.
#
# Azure, Deepgram, ElevenLabs, DashScope, and other historical adapter files are
# not current selectable provider profiles.

# Translation scheduling for the configured default LLM provider.
TRANSLATION_CONCURRENCY=5
TRANSLATION_REQUEST_TIMEOUT_SECONDS=60
TRANSLATION_MAX_RETRIES=2
TRANSLATION_RETRY_BASE_SECONDS=0.8
TRANSLATION_MAX_CONNECTIONS=200
TRANSLATION_MAX_KEEPALIVE_CONNECTIONS=50

PROCESSING_LOCK_TIMEOUT_SECONDS=1800
PROCESSING_LOCK_HEARTBEAT_SECONDS=10
JOB_WORKER_CONCURRENCY=1
JOB_POLL_INTERVAL_SECONDS=0.25
RECORDING_MAX_DURATION_SECONDS=90
RECORDING_MAX_BYTES=26214400

# Optional evaluation configuration.
ENABLE_WAVLM_SCORE=true
ENABLE_PROSODY_SCORE=true
ENABLE_TRIM_SILENCE=true
EVAL_WEIGHT_CONTENT=0.40
EVAL_WEIGHT_IMITATION=0.35
EVAL_WEIGHT_PROSODY=0.25
EVAL_SAMPLE_RATE=16000
TRIM_SAMPLE_RATE=16000
TRIM_TOP_DB=30
TRIM_FRAME_LENGTH=1024
TRIM_HOP_LENGTH=256
TRIM_PAD_SEC=0.20
TRIM_MIN_DURATION_SEC=0.30
PROSODY_BACKEND=librosa_pyin
WAVLM_MODEL_NAME=microsoft/wavlm-base-plus
WAVLM_DEVICE=cpu
WAVLM_CHUNK_COUNT=4
WAVLM_MIN_CHUNK_SECONDS=0.35
