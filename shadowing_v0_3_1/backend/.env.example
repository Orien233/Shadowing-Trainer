# Core runtime
APP_VERSION=0.4.0
DATA_DIR=./data
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Compatibility only: used by the existing translation flow when no LLM
# provider has been saved in Settings. New LLM/TTS/remote-ASR providers are
# stored in the database through the Settings panel, not in this file.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=

# The two local-ASR scene switches live in the database and default to true:
# material_transcription_use_local controls upload/material transcription;
# recording_evaluation_use_local controls learner-recording evaluation.
#
# Provider types in Settings:
# - openai_compatible: OpenAI Audio API request shapes (/audio/speech and
#   /audio/transcriptions) for TTS/ASR.
# - azure_speech: Azure Speech REST/SSML adapter; use a region-specific Azure
#   Speech endpoint and subscription key.
